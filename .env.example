# Optional: Google Maps API Key (für Maps JavaScript API und Google Isochrones API)
# Falls nicht gesetzt, nutzt die App automatisch freies OpenStreetMap & das Offline-Modell
VITE_GOOGLE_MAPS_API_KEY=""

# Optional: OpenRouteService API Key (für alternative Pkw/Rad/Fuß-Isochronen via HeiGIT)
VITE_ORS_API_KEY=""

# Optional: Gemini API Key (falls zukünftig KI-Funktionen / LLM-Features angebunden werden)
GEMINI_API_KEY=""
